        ]
       },
       {
        "name": "template-string",
        "patterns": [
         {
          "pattern": "`(?:\\\\[\\s\\S]|\\$\\{(?:[^{}]|\\{(?:[^{}]|\\{[^}]*\\})*\\})+\\}|(?!\\$\\{)[^\\\\`])*`",
          "flags": "",
          "greedy": true,
