          "pattern": "((?:^|[,{])[ \\t]*)([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\2)[^\\\\\\r\\n])*\\2(?=\\s*:)",
          "flags": "m",
          "lookbehind": true,
          "greedy": true,
          "alias": [
           "property"
