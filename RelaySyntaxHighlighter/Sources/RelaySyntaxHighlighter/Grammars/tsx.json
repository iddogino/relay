             "patterns": [
              {
               "pattern": "^`|`$",
               "flags": "",
               "alias": [
                "string"
               ]
              }
             ]
            },
            {
             "name": "interpolation",
             "patterns": [
              {
               "pattern": "((?:^|[^\\\\])(?:\\\\{2})*)\\$\\{(?:[^{}]|\\{(?:[^{}]|\\{[^}]*\\})*\\})+\\}",
               "flags": "",
               "lookbehind": true,
               "inside": {
                "rules": [
                 {
                  "name": "interpolation-punctuation",
                  "patterns": [
                   {
                    "pattern": "^\\$\\{|\\}$",
                    "flags": "",
                    "alias": [
