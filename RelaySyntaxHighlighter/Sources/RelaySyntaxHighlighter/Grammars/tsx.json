   ]
  },
  {
   "name": "class-name",
   "patterns": [
    {
     "pattern": "(\\b(?:class|extends|implements|instanceof|interface|new|type)\\s+)(?!keyof\\b)(?!\\s)[_$a-zA-Z\\xA0-\\uFFFF](?:(?!\\s)[$\\w\\xA0-\\uFFFF])*(?:\\s*<(?:[^<>]|<(?:[^<>]|<[^<>]*>)*>)*>)?",
     "flags": "",
     "lookbehind": true,
     "greedy": true,
     "inside": {
      "rules": [
       {
        "name": "comment",
        "patterns": [
         {
          "pattern": "(^|[^\\\\])\\/\\*[\\s\\S]*?(?:\\*\\/|$)",
          "flags": "",
          "lookbehind": true,
          "greedy": true
         },
         {
          "pattern": "(^|[^\\\\:])\\/\\/.*",
          "flags": "",
          "lookbehind": true,
          "greedy": true
         }
        ]
       },
       {
        "name": "hashbang",
        "patterns": [
