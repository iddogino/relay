    }
   ]
  },
  {
   "name": "template-string",
   "patterns": [
    {
     "pattern": "`(?:\\\\[\\s\\S]|\\$\\{(?:[^{}]|\\{(?:[^{}]|\\{[^}]*\\})*\\})+\\}|(?!\\$\\{)[^\\\\`])*`",
     "flags": "",
     "greedy": true,
     "inside": {
      "rules": [
       {
        "name": "template-punctuation",
        "patterns": [
         {
          "pattern": "^`|`$",
          "flags": "",
          "alias": [
           "string"
          ]
         }
        ]
       },
       {
        "name": "interpolation",
        "patterns": [
         {
          "pattern": "((?:^|[^\\\\])(?:\\\\{2})*)\\$\\{(?:[^{}]|\\{(?:[^{}]|\\{[^}]*\\})*\\})+\\}",
          "flags": "",
          "lookbehind": true,
          "inside": {
           "rules": [
            {
             "name": "interpolation-punctuation",
             "patterns": [
              {
               "pattern": "^\\$\\{|\\}$",
               "flags": "",
               "alias": [
                "punctuation"
               ]
              }
             ]
            }
           ],
           "rest": {
            "$language": "typescript"
           }
          }
         }
        ]
       },
       {
        "name": "string",
        "patterns": [
         {
          "pattern": "[\\s\\S]+",
          "flags": ""
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "string-property",
   "patterns": [
    {
     "pattern": "((?:^|[,{])[ \\t]*)([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\2)[^\\\\\\r\\n])*\\2(?=\\s*:)",
     "flags": "m",
     "lookbehind": true,
     "greedy": true,
     "alias": [
      "property"
     ]
    }
   ]
  },
  {
   "name": "string",
   "patterns": [
    {
     "pattern": "([\"'])(?:\\\\(?:\\r\\n|[\\s\\S])|(?!\\1)[^\\\\\\r\\n])*\\1",
     "flags": "",
     "greedy": true
