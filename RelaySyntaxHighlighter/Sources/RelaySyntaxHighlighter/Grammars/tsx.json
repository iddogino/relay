{
 "language": "tsx",
 "prismVersion": "1.29.0",
 "rules": [
  {
   "name": "comment",
   "patterns": [
    {
     "pattern": "(^|[^\\\\])\\/\\*[\\s\\S]*?(?:\\*\\/|$)",
     "flags": "",
     "lookbehind": true,
     "greedy": true
    },
    {
     "pattern": "(^|[^\\\\:])\\/\\/.*",
     "flags": "",
     "lookbehind": true,
     "greedy": true
    }
   ]
  },
  {
   "name": "prolog",
   "patterns": [
    {
     "pattern": "<\\?[\\s\\S]+?\\?>",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "doctype",
   "patterns": [
    {
     "pattern": "<!DOCTYPE(?:[^>\"'[\\]]|\"[^\"]*\"|'[^']*')+(?:\\[(?:[^<\"'\\]]|\"[^\"]*\"|'[^']*'|<(?!!--)|<!--(?:[^-]|-(?!->))*-->)*\\]\\s*)?>",
     "flags": "i",
     "greedy": true,
     "inside": {
      "rules": [
       {
        "name": "internal-subset",
        "patterns": [
         {
          "pattern": "(^[^\\[]*\\[)[\\s\\S]+(?=\\]>$)",
          "flags": "",
          "lookbehind": true,
          "greedy": true,
          "inside": {
           "$language": "tsx"
          }
         }
        ]
       },
       {
        "name": "string",
        "patterns": [
         {
          "pattern": "\"[^\"]*\"|'[^']*'",
          "flags": "",
          "greedy": true
         }
        ]
       },
       {
        "name": "punctuation",
        "patterns": [
         {
          "pattern": "^<!|>$|[[\\]]",
          "flags": ""
         }
        ]
       },
       {
        "name": "doctype-tag",
        "patterns": [
         {
          "pattern": "^DOCTYPE",
          "flags": "i"
         }
        ]
       },
       {
        "name": "name",
        "patterns": [
         {
          "pattern": "[^\\s<>'\"]+",
          "flags": ""
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "script",
   "patterns": [
    {
     "pattern": "(<script[^>]*>)(?:<!\\[CDATA\\[(?:[^\\]]|\\](?!\\]>))*\\]\\]>|(?!<!\\[CDATA\\[)[\\s\\S])*?(?=<\\/script>)",
     "flags": "i",
     "lookbehind": true,
     "greedy": true,
     "inside": {
      "rules": [
       {
        "name": "included-cdata",
        "patterns": [
         {
          "pattern": "<!\\[CDATA\\[[\\s\\S]*?\\]\\]>",
          "flags": "i",
          "inside": {
           "rules": [
            {
             "name": "language-javascript",
             "patterns": [
              {
               "pattern": "(^<!\\[CDATA\\[)[\\s\\S]+?(?=\\]\\]>$)",
               "flags": "i",
               "lookbehind": true,
               "inside": {
                "$language": "javascript"
               }
              }
             ]
            },
            {
             "name": "cdata",
             "patterns": [
              {
               "pattern": "^<!\\[CDATA\\[|\\]\\]>$",
               "flags": "i"
              }
             ]
            }
           ]
          }
         }
        ]
       },
       {
        "name": "language-javascript",
        "patterns": [
         {
          "pattern": "[\\s\\S]+",
          "flags": "",
          "inside": {
           "$language": "javascript"
          }
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "cdata",
   "patterns": [
    {
     "pattern": "<!\\[CDATA\\[[\\s\\S]*?\\]\\]>",
     "flags": "i",
     "greedy": true
    }
   ]
  },
  {
   "name": "tag",
   "patterns": [
    {
     "pattern": "(^|[^\\w$]|(?=<\\/))(?:<\\/?(?:[\\w.:-]+(?:(?:\\s|\\/\\/.*(?!.)|\\/\\*(?:[^*]|\\*(?!\\/))\\*\\/)+(?:[\\w.:$-]+(?:=(?:\"(?:\\\\[\\s\\S]|[^\\\\\"])*\"|'(?:\\\\[\\s\\S]|[^\\\\'])*'|[^\\s{'\"/>=]+|(?:\\{(?:\\{(?:\\{[^{}]*\\}|[^{}])*\\}|[^{}])*\\})))?|(?:\\{(?:\\s|\\/\\/.*(?!.)|\\/\\*(?:[^*]|\\*(?!\\/))\\*\\/)*\\.{3}(?:[^{}]|(?:\\{(?:\\{(?:\\{[^{}]*\\}|[^{}])*\\}|[^{}])*\\}))*\\})))*(?:\\s|\\/\\/.*(?!.)|\\/\\*(?:[^*]|\\*(?!\\/))\\*\\/)*\\/?)?>)",
     "flags": "",
     "lookbehind": true,
     "greedy": true,
     "inside": {
      "rules": [
       {
        "name": "tag",
        "patterns": [
         {
          "pattern": "^<\\/?[^\\s>\\/]*",
          "flags": "",
          "inside": {
           "rules": [
            {
             "name": "punctuation",
             "patterns": [
              {
               "pattern": "^<\\/?",
               "flags": ""
              }
             ]
            },
            {
             "name": "namespace",
             "patterns": [
              {
               "pattern": "^[^\\s>\\/:]+:",
               "flags": ""
              }
             ]
            },
            {
             "name": "class-name",
             "patterns": [
              {
               "pattern": "^[A-Z]\\w*(?:\\.[A-Z]\\w*)*$",
               "flags": ""
              }
             ]
            }
           ]
          }
         }
        ]
       },
       {
        "name": "script",
        "patterns": [
         {
          "pattern": "=(?:\\{(?:\\{(?:\\{[^{}]*\\}|[^{}])*\\}|[^{}])*\\})",
          "flags": "",
          "alias": [
           "language-javascript"
          ],
          "inside": {
           "rules": [
            {
             "name": "script-punctuation",
             "patterns": [
              {
               "pattern": "^=(?=\\{)",
               "flags": "",
               "alias": [
                "punctuation"
               ]
              }
             ]
            }
           ],
           "rest": {
            "$language": "tsx"
           }
          }
         }
        ]
       },
       {
        "name": "special-attr",
        "patterns": [
         {
          "pattern": "(^|[\"'\\s])(?:on(?:abort|blur|change|click|composition(?:end|start|update)|dblclick|error|focus(?:in|out)?|key(?:down|up)|load|mouse(?:down|enter|leave|move|out|over|up)|reset|resize|scroll|select|slotchange|submit|unload|wheel))\\s*=\\s*(?:\"[^\"]*\"|'[^']*'|[^\\s'\">=]+(?=[\\s>]))",
          "flags": "i",
          "lookbehind": true,
          "inside": {
           "rules": [
            {
             "name": "attr-name",
             "patterns": [
              {
               "pattern": "^[^\\s=]+",
               "flags": ""
              }
             ]
            },
            {
             "name": "attr-value",
             "patterns": [
              {
               "pattern": "=[\\s\\S]+",
               "flags": "",
               "inside": {
                "rules": [
                 {
                  "name": "value",
                  "patterns": [
                   {
                    "pattern": "(^=\\s*([\"']|(?![\"'])))\\S[\\s\\S]*(?=\\2$)",
                    "flags": "",
                    "lookbehind": true,
                    "alias": [
                     "javascript",
                     "language-javascript"
                    ],
                    "inside": {
                     "$language": "javascript"
                    }
                   }
                  ]
                 },
                 {
                  "name": "punctuation",
                  "patterns": [
                   {
                    "pattern": "^=",
                    "flags": "",
                    "alias": [
                     "attr-equals"
                    ]
                   },
                   {
                    "pattern": "\"|'",
                    "flags": ""
                   }
                  ]
                 }
                ]
               }
              }
             ]
            }
           ]
          }
         }
        ]
       },
       {
        "name": "attr-value",
        "patterns": [
         {
          "pattern": "=(?!\\{)(?:\"(?:\\\\[\\s\\S]|[^\\\\\"])*\"|'(?:\\\\[\\s\\S]|[^\\\\'])*'|[^\\s'\">]+)",
          "flags": "",
          "inside": {
           "rules": [
            {
             "name": "punctuation",
             "patterns": [
              {
               "pattern": "^=",
               "flags": "",
               "alias": [
                "attr-equals"
               ]
              },
              {
               "pattern": "^(\\s*)[\"']|[\"']$",
               "flags": "",
               "lookbehind": true
              }
             ]
            },
            {
             "name": "entity",
             "patterns": [
              {
               "pattern": "&[\\da-z]{1,8};",
               "flags": "i",
               "alias": [
                "named-entity"
               ]
              },
              {
               "pattern": "&#x?[\\da-f]{1,8};",
               "flags": "i"
              }
             ]
            }
           ]
          }
         }
        ]
       },
       {
        "name": "punctuation",
        "patterns": [
         {
          "pattern": "\\/?>",
          "flags": ""
         }
        ]
       },
       {
        "name": "spread",
        "patterns": [
         {
          "pattern": "(?:\\{(?:\\s|\\/\\/.*(?!.)|\\/\\*(?:[^*]|\\*(?!\\/))\\*\\/)*\\.{3}(?:[^{}]|(?:\\{(?:\\{(?:\\{[^{}]*\\}|[^{}])*\\}|[^{}])*\\}))*\\})",
          "flags": "",
          "inside": {
           "$language": "tsx"
          }
         }
        ]
       },
       {
        "name": "attr-name",
        "patterns": [
         {
          "pattern": "[^\\s>\\/]+",
          "flags": "",
          "inside": {
           "rules": [
            {
             "name": "namespace",
             "patterns": [
              {
               "pattern": "^[^\\s>\\/:]+:",
               "flags": ""
              }
             ]
            }
           ]
          }
         }
        ]
       },
       {
        "name": "comment",
        "patterns": [
         {
          "pattern": "(^|[^\\\\])\\/\\*[\\s\\S]*?(?:\\*\\/|$)",
          "flags": "",
          "lookbehind": true,
          "greedy": true
         },
         {
          "pattern": "(^|[^\\\\:])\\/\\/.*",
          "flags": "",
          "lookbehind": true,
          "greedy": true
         }
        ]
       }
      ]
     }
    }
