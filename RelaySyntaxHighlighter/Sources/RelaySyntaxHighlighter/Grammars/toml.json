{
 "language": "toml",
 "prismVersion": "1.29.0",
 "rules": [
  {
   "name": "comment",
   "patterns": [
    {
     "pattern": "#.*",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "table",
   "patterns": [
    {
     "pattern": "(^[\\t ]*\\[\\s*(?:\\[\\s*)?)(?:[\\w-]+|'[^'\\n\\r]*'|\"(?:\\\\.|[^\\\\\"\\r\\n])*\")(?:\\s*\\.\\s*(?:[\\w-]+|'[^'\\n\\r]*'|\"(?:\\\\.|[^\\\\\"\\r\\n])*\"))*(?=\\s*\\])",
     "flags": "m",
     "lookbehind": true,
     "greedy": true,
     "alias": [
      "class-name"
     ]
    }
   ]
  },
  {
   "name": "key",
   "patterns": [
    {
     "pattern": "(^[\\t ]*|[{,]\\s*)(?:[\\w-]+|'[^'\\n\\r]*'|\"(?:\\\\.|[^\\\\\"\\r\\n])*\")(?:\\s*\\.\\s*(?:[\\w-]+|'[^'\\n\\r]*'|\"(?:\\\\.|[^\\\\\"\\r\\n])*\"))*(?=\\s*=)",
     "flags": "m",
     "lookbehind": true,
     "greedy": true,
     "alias": [
      "property"
     ]
    }
   ]
  },
  {
   "name": "string",
   "patterns": [
    {
     "pattern": "\"\"\"(?:\\\\[\\s\\S]|[^\\\\])*?\"\"\"|'''[\\s\\S]*?'''|'[^'\\n\\r]*'|\"(?:\\\\.|[^\\\\\"\\r\\n])*\"",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "date",
   "patterns": [
    {
     "pattern": "\\b\\d{4}-\\d{2}-\\d{2}(?:[T\\s]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:Z|[+-]\\d{2}:\\d{2})?)?\\b",
     "flags": "i",
     "alias": [
      "number"
     ]
    },
    {
     "pattern": "\\b\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?\\b",
     "flags": "",
     "alias": [
      "number"
     ]
    }
   ]
  },
  {
   "name": "number",
   "patterns": [
    {
     "pattern": "(?:\\b0(?:x[\\da-zA-Z]+(?:_[\\da-zA-Z]+)*|o[0-7]+(?:_[0-7]+)*|b[10]+(?:_[10]+)*))\\b|[-+]?\\b\\d+(?:_\\d+)*(?:\\.\\d+(?:_\\d+)*)?(?:[eE][+-]?\\d+(?:_\\d+)*)?\\b|[-+]?\\b(?:inf|nan)\\b",
     "flags": ""
    }
   ]
  },
  {
   "name": "boolean",
   "patterns": [
    {
     "pattern": "\\b(?:false|true)\\b",
     "flags": ""
    }
   ]
  },
  {
   "name": "punctuation",
   "patterns": [
    {
     "pattern": "[.,=[\\]{}]",
     "flags": ""
    }
   ]
  }
 ]
}
