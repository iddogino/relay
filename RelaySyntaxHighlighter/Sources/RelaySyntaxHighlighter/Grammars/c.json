{
 "language": "c",
 "prismVersion": "1.29.0",
 "rules": [
  {
   "name": "comment",
   "patterns": [
    {
     "pattern": "\\/\\/(?:[^\\r\\n\\\\]|\\\\(?:\\r\\n?|\\n|(?![\\r\\n])))*|\\/\\*[\\s\\S]*?(?:\\*\\/|$)",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "char",
   "patterns": [
    {
     "pattern": "'(?:\\\\(?:\\r\\n|[\\s\\S])|[^'\\\\\\r\\n]){0,32}'",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "macro",
   "patterns": [
    {
     "pattern": "(^[\\t ]*)#\\s*[a-z](?:[^\\r\\n\\\\/]|\\/(?!\\*)|\\/\\*(?:[^*]|\\*(?!\\/))*\\*\\/|\\\\(?:\\r\\n|[\\s\\S]))*",
     "flags": "im",
     "lookbehind": true,
     "greedy": true,
     "alias": [
      "property"
     ],
     "inside": {
      "rules": [
       {
        "name": "string",
        "patterns": [
         {
          "pattern": "^(#\\s*include\\s*)<[^>]+>",
          "flags": "",
          "lookbehind": true
         },
         {
          "pattern": "\"(?:\\\\(?:\\r\\n|[\\s\\S])|[^\"\\\\\\r\\n])*\"",
          "flags": "",
          "greedy": true
         }
        ]
       },
       {
        "name": "char",
        "patterns": [
         {
          "pattern": "'(?:\\\\(?:\\r\\n|[\\s\\S])|[^'\\\\\\r\\n]){0,32}'",
          "flags": "",
          "greedy": true
         }
        ]
       },
       {
        "name": "comment",
        "patterns": [
         {
          "pattern": "\\/\\/(?:[^\\r\\n\\\\]|\\\\(?:\\r\\n?|\\n|(?![\\r\\n])))*|\\/\\*[\\s\\S]*?(?:\\*\\/|$)",
          "flags": "",
          "greedy": true
         }
        ]
       },
       {
        "name": "macro-name",
        "patterns": [
         {
          "pattern": "(^#\\s*define\\s+)\\w+\\b(?!\\()",
          "flags": "i",
          "lookbehind": true
         },
         {
          "pattern": "(^#\\s*define\\s+)\\w+\\b(?=\\()",
          "flags": "i",
          "lookbehind": true,
          "alias": [
           "function"
          ]
         }
        ]
       },
       {
        "name": "directive",
        "patterns": [
         {
          "pattern": "^(#\\s*)[a-z]+",
          "flags": "",
          "lookbehind": true,
          "alias": [
           "keyword"
          ]
         }
        ]
       },
       {
        "name": "directive-hash",
        "patterns": [
         {
          "pattern": "^#",
          "flags": ""
         }
        ]
       },
       {
        "name": "punctuation",
        "patterns": [
         {
          "pattern": "##|\\\\(?=[\\r\\n])",
          "flags": ""
         }
        ]
       },
       {
        "name": "expression",
        "patterns": [
         {
          "pattern": "\\S[\\s\\S]*",
          "flags": "",
          "inside": {
           "$language": "c"
          }
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "name": "string",
   "patterns": [
    {
     "pattern": "\"(?:\\\\(?:\\r\\n|[\\s\\S])|[^\"\\\\\\r\\n])*\"",
     "flags": "",
     "greedy": true
    }
   ]
  },
  {
   "name": "class-name",
   "patterns": [
    {
     "pattern": "(\\b(?:enum|struct)\\s+(?:__attribute__\\s*\\(\\([\\s\\S]*?\\)\\)\\s*)?)\\w+|\\b[a-z]\\w*_t\\b",
     "flags": "",
     "lookbehind": true
    }
   ]
  },
  {
   "name": "keyword",
   "patterns": [
    {
     "pattern": "\\b(?:_Alignas|_Alignof|_Atomic|_Bool|_Complex|_Generic|_Imaginary|_Noreturn|_Static_assert|_Thread_local|__attribute__|asm|auto|break|case|char|const|continue|default|do|double|else|enum|extern|float|for|goto|if|inline|int|long|register|return|short|signed|sizeof|static|struct|switch|typedef|typeof|union|unsigned|void|volatile|while)\\b",
     "flags": ""
    }
   ]
  },
  {
   "name": "constant",
   "patterns": [
    {
     "pattern": "\\b(?:EOF|NULL|SEEK_CUR|SEEK_END|SEEK_SET|__DATE__|__FILE__|__LINE__|__TIMESTAMP__|__TIME__|__func__|stderr|stdin|stdout)\\b",
     "flags": ""
    }
   ]
  },
  {
   "name": "function",
   "patterns": [
    {
     "pattern": "\\b[a-z_]\\w*(?=\\s*\\()",
     "flags": "i"
    }
   ]
  },
  {
   "name": "number",
   "patterns": [
    {
     "pattern": "(?:\\b0x(?:[\\da-f]+(?:\\.[\\da-f]*)?|\\.[\\da-f]+)(?:p[+-]?\\d+)?|(?:\\b\\d+(?:\\.\\d*)?|\\B\\.\\d+)(?:e[+-]?\\d+)?)[ful]{0,4}",
     "flags": "i"
    }
   ]
  },
  {
   "name": "operator",
   "patterns": [
    {
     "pattern": ">>=?|<<=?|->|([-+&|:])\\1|[?:~]|[-+*/%&|^!=<>]=?",
     "flags": ""
    }
   ]
  },
  {
   "name": "punctuation",
   "patterns": [
    {
     "pattern": "[{}[\\];(),.:]",
     "flags": ""
    }
   ]
  }
 ]
}
