+    /// exits: it shows the exit or closes, per wait-after-command, and
+    /// stops calling io_write_cb. Callable from any thread (not overlapping
+    /// ghostty_surface_free). Returns false, and does nothing, if an exit
+    /// was already reported or the surface isn't in manual mode.
+    export fn ghostty_surface_report_exit(
+        surface: *Surface,
+        exit_code: u32,
+    ) bool {
+        return switch (surface.core_surface.io.backend) {
+            .manual => |*manual| manual.requestExit(exit_code),
+            else => false,
+        };
+    }
