+    /// Feeds output from a manual surface's program to the terminal, as
+    /// though it were read from a pty. Callable from any thread except the
+    /// one that runs the app (ghostty_app_tick): feeding can block until
+    /// the app drains its mailbox, which is the backpressure a pty would
+    /// apply. Calls must be serialized by the caller (output is
+    /// order-sensitive) and must not overlap or follow
+    /// ghostty_surface_free. Ignored for surfaces not in manual mode.
+    export fn ghostty_surface_write_output(
+        surface: *Surface,
+        ptr: ?[*]const u8,
+        len: usize,
+    ) void {
+        const bytes = ptr orelse return;
+        if (len == 0) return;
+        if (surface.core_surface.io.backend != .manual) {
+            log.warn("ghostty_surface_write_output on a surface not in manual io mode", .{});
+            return;
+        }
+        // In pieces, like the exec backend's pty reads, so the renderer
+        // lock is released between them however large the buffer is.
+        const chunk = 64 * 1024;
+        var i: usize = 0;
+        while (i < len) : (i += chunk) {
+            surface.core_surface.io.processOutput(bytes[i..@min(len, i + chunk)]);
+        }
+    }
+
