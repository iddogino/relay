--- /dev/null
+++ b/src/termio/Manual.zig
@@ -0,0 +1,487 @@
+//! Manual is a termio backend with no subprocess and no pty. The embedder
+//! owns the program's I/O (for example an SSH channel): it feeds the
+//! program's output to the terminal with `Termio.processOutput`, and it
+//! receives everything the terminal sends back to the program — encoded
+//! keys, pastes, replies to terminal queries — and every grid size change
+//! through the callbacks in `Config`. When the program ends, the embedder
+//! calls `requestExit`, which the surface handles exactly like a child
+//! process exiting.
+//!
+//! Threading contract for the callbacks:
+//!   - `write` runs on the termio thread. `resize` runs on the termio
+//!     thread, except for the initial size, which is reported on the
+//!     thread creating the surface.
+//!   - Either may run with the renderer state lock held, so a callback
+//!     must not call back into the surface. It must not block either
+//!     (the termio thread, and with it keyboard input, would stall) — in
+//!     particular not on the thread feeding output, which may itself be
+//!     waiting on the termio thread. It should copy what it needs (the data
+//!     pointer is only valid during the call) and return.
+//!   - Neither runs after the surface has been freed.
+//!
+//! Feeding output (`ghostty_surface_write_output`) can block until the
+//! app thread drains its mailbox, so it must not be done on that thread
+//! (the one calling `ghostty_app_tick`).
+const Manual = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const global = @import("../global.zig");
+const xev = global.xev;
+const apprt = @import("../apprt.zig");
+const renderer = @import("../renderer.zig");
+const terminal = @import("../terminal/main.zig");
+const termio = @import("../termio.zig");
+const ProcessInfo = @import("../pty.zig").ProcessInfo;
+
+const log = std.log.scoped(.io_manual);
+
+/// Receives bytes the terminal writes to the program. `data` is only
+/// valid for the duration of the call.
+pub const WriteCallback = *const fn (
+    userdata: ?*anyopaque,
+    data: [*]const u8,
+    len: usize,
+) callconv(.c) void;
+
+/// Receives the terminal's grid size (columns, rows) and its size in
+/// pixels (width, height).
+pub const ResizeCallback = *const fn (
+    userdata: ?*anyopaque,
+    columns: u16,
+    rows: u16,
+    width_px: u32,
+    height_px: u32,
+) callconv(.c) void;
+
+pub const Config = struct {
+    userdata: ?*anyopaque = null,
+    write: WriteCallback,
+    resize: ?ResizeCallback = null,
+};
+
+/// A grid size together with its pixel dimensions.
+pub const Size = struct {
+    columns: u16,
+    rows: u16,
+    width_px: u32,
+    height_px: u32,
+};
+
+/// The exit state packs "requested" (bit 32) and the exit code (low 32
+/// bits) into one word so they are published together.
+const exit_requested_bit: u64 = 1 << 32;
+
+cfg: Config,
+
+/// The last size reported to the embedder. Written by `initTerminal`
+/// before the termio thread starts and by `resize` on the termio thread
+/// afterwards, so it needs no lock.
+size: ?Size = null,
+
+/// When the surface's backend was created, for the exit's runtime.
+start: std.Io.Timestamp,
+
+/// Set once by `requestExit` from any thread; see `exit_requested_bit`.
+exit_state: std.atomic.Value(u64) = .init(0),
+
+/// Wakes the termio thread to deliver a requested exit. `requestExit`
+/// may be called on the app thread, which drains the surface mailbox and
+/// so must never block pushing to it; the termio thread delivers the exit
+/// instead, as the exec backend's process watcher does.
+exit_async: xev.Async,
+
+/// The wait on `exit_async`, and what its callback needs. These live here,
+/// not in the termio thread data, so the armed wait never points into a
+/// stack frame that may be gone: if thread entry fails after this backend
+/// entered (e.g. the configured input can't be read), the termio thread
+/// drains its loop after `threadExit` with the thread data already gone.
+/// All termio-thread only.
+exit_c: xev.Completion = .{},
+surface_mailbox: ?apprt.surface.Mailbox = null,
+/// The exit has been delivered to the surface.
+exited: bool = false,
+/// The termio thread is leaving; a pending wait just ends.
+stopping: bool = false,
+
+pub fn init(cfg: Config) !Manual {
+    var exit_async = try xev.Async.init();
+    errdefer exit_async.deinit();
+    return .{
+        .cfg = cfg,
+        .start = .now(global.io(), .awake),
+        .exit_async = exit_async,
+    };
+}
+
+pub fn deinit(self: *Manual) void {
+    self.exit_async.deinit();
+}
+
+pub fn initTerminal(self: *Manual, term: *terminal.Terminal) void {
+    self.resize(.{
+        .columns = term.cols,
+        .rows = term.rows,
+    }, .{
+        .width = term.width_px,
+        .height = term.height_px,
+    }) catch unreachable;
+}
+
+pub fn threadEnter(
+    self: *Manual,
+    alloc: Allocator,
+    io: *termio.Termio,
+    td: *termio.Termio.ThreadData,
+) !void {
+    _ = alloc;
+    _ = io;
+    td.backend = .{ .manual = .{ .manual = self } };
+    self.surface_mailbox = td.surface_mailbox;
+    self.stopping = false;
+    self.exit_async.wait(td.loop, &self.exit_c, Manual, self, exitCallback);
+
+    // An exit requested before the thread started has already notified
+    // the handle, which stays signaled until waited on; nothing else to do.
+}
+
+pub fn threadExit(self: *Manual, td: *termio.Termio.ThreadData) void {
+    _ = td;
+    // If the loop runs again (it drains after a failed thread entry), the
+    // pending wait fires and ends instead of keeping the loop alive.
+    self.stopping = true;
+    if (self.exit_c.state() == .active) self.exit_async.notify() catch |err| {
+        log.warn("error ending the manual exit wait err={}", .{err});
+    };
+}
+
+pub fn focusGained(
+    self: *Manual,
+    td: *termio.Termio.ThreadData,
+    focused: bool,
+) !void {
+    _ = self;
+    _ = td;
+    _ = focused;
+}
+
+pub fn resize(
+    self: *Manual,
+    grid_size: renderer.GridSize,
+    screen_size: renderer.ScreenSize,
+) !void {
+    const size: Size = .{
+        .columns = grid_size.columns,
+        .rows = grid_size.rows,
+        .width_px = screen_size.width,
+        .height_px = screen_size.height,
+    };
+    if (self.size) |prev| if (std.meta.eql(prev, size)) return;
+    self.size = size;
+    if (self.cfg.resize) |cb| cb(
+        self.cfg.userdata,
+        size.columns,
+        size.rows,
+        size.width_px,
+        size.height_px,
+    );
+}
+
+pub fn queueWrite(
+    self: *Manual,
+    alloc: Allocator,
+    td: *termio.Termio.ThreadData,
+    data: []const u8,
+    linefeed: bool,
+) !void {
+    _ = alloc;
+    _ = td;
+    // Like a pty after its process exits, nothing is written anymore.
+    if (self.exited or self.exitRequested()) return;
+    self.write(data, linefeed);
+}
+
+/// Hands `data` to the write callback, translating CR to CRLF when the
+/// terminal is in linefeed mode (as the exec backend does for its pty).
+fn write(self: *const Manual, data: []const u8, linefeed: bool) void {
+    if (data.len == 0) return;
+    if (!linefeed) {
+        self.cfg.write(self.cfg.userdata, data.ptr, data.len);
+        return;
+    }
+
+    var buf: [1024]u8 = undefined;
+    var buf_i: usize = 0;
+    for (data) |ch| {
+        // Leave room for a CRLF pair.
+        if (buf_i >= buf.len - 1) {
+            self.cfg.write(self.cfg.userdata, &buf, buf_i);
+            buf_i = 0;
+        }
+        buf[buf_i] = ch;
+        buf_i += 1;
+        if (ch == '\r') {
+            buf[buf_i] = '\n';
+            buf_i += 1;
+        }
+    }
+    if (buf_i > 0) self.cfg.write(self.cfg.userdata, &buf, buf_i);
+}
+
+/// Called from any thread when the program has ended. Only the first
+/// call has an effect. Returns whether this call was the first.
+pub fn requestExit(self: *Manual, exit_code: u32) bool {
+    if (self.exit_state.cmpxchgStrong(
+        0,
+        exit_requested_bit | exit_code,
+        .acq_rel,
+        .acquire,
+    ) != null) return false;
+    self.exit_async.notify() catch |err| {
+        // Without the wakeup the surface would never learn of the exit.
+        log.err("error notifying termio thread of exit err={}", .{err});
+    };
+    return true;
+}
+
+fn exitRequested(self: *const Manual) bool {
+    return self.exit_state.load(.acquire) & exit_requested_bit != 0;
+}
+
+fn exitCallback(
+    self_: ?*Manual,
+    _: *xev.Loop,
+    _: *xev.Completion,
+    r: xev.Async.WaitError!void,
+) xev.CallbackAction {
+    const self = self_.?;
+    _ = r catch |err| {
+        // Rearming could spin on a persistent error; without the wait the
+        // exit is lost, but the surface stays usable.
+        log.err("error waiting for manual exit err={}", .{err});
+        return .disarm;
+    };
+    if (self.stopping or self.exited) return .disarm;
+
+    const state = self.exit_state.load(.acquire);
+    if (state & exit_requested_bit == 0) return .rearm;
+    self.exited = true;
+
+    const exit_code: u32 = @truncate(state);
+    const runtime_ms: u64 = @intCast(@max(
+        0,
+        self.start.untilNow(global.io(), .awake).toMilliseconds(),
+    ));
+    log.debug("manual io exited status={} runtime={}ms", .{ exit_code, runtime_ms });
+
+    // Pushed from the termio thread, never the app thread that drains it.
+    _ = self.surface_mailbox.?.push(.{
+        .child_exited = .{
+            .exit_code = exit_code,
+            .runtime_ms = runtime_ms,
+        },
+    }, .{ .forever = {} });
+    return .disarm;
+}
+
+pub fn childExitedAbnormally(
+    self: *Manual,
+    gpa: Allocator,
+    t: *terminal.Terminal,
+    exit_code: u32,
+    runtime_ms: u64,
+) !void {
+    _ = self;
+    _ = gpa;
+    _ = t;
+    _ = exit_code;
+    _ = runtime_ms;
+}
+
+/// There is no local process to describe.
+pub fn getProcessInfo(self: *Manual, comptime info: ProcessInfo) ?ProcessInfo.Type(info) {
+    _ = self;
+    return null;
+}
+
+pub const ThreadData = struct {
+    manual: *Manual,
+
+    pub fn deinit(self: *ThreadData, alloc: Allocator) void {
+        _ = self;
+        _ = alloc;
+    }
+};
+
+// Tests exercise the write and size paths directly; the exit path needs a
+// running termio thread and is covered by the embedder's integration tests.
+
+const testing = std.testing;
+
+const Recorder = struct {
+    writes: std.ArrayList([]u8) = .empty,
+    sizes: std.ArrayList(Size) = .empty,
+
+    fn deinit(self: *Recorder) void {
+        for (self.writes.items) |w| testing.allocator.free(w);
+        self.writes.deinit(testing.allocator);
+        self.sizes.deinit(testing.allocator);
+    }
+
+    fn joined(self: *const Recorder) ![]u8 {
+        var all: std.ArrayList(u8) = .empty;
+        for (self.writes.items) |w| try all.appendSlice(testing.allocator, w);
+        return all.toOwnedSlice(testing.allocator);
+    }
+
+    fn onWrite(ud: ?*anyopaque, data: [*]const u8, len: usize) callconv(.c) void {
+        const self: *Recorder = @ptrCast(@alignCast(ud.?));
+        const copy = testing.allocator.dupe(u8, data[0..len]) catch unreachable;
+        self.writes.append(testing.allocator, copy) catch unreachable;
+    }
+
+    fn onResize(ud: ?*anyopaque, c: u16, r: u16, w: u32, h: u32) callconv(.c) void {
+        const self: *Recorder = @ptrCast(@alignCast(ud.?));
+        self.sizes.append(testing.allocator, .{
+            .columns = c,
+            .rows = r,
+            .width_px = w,
+            .height_px = h,
+        }) catch unreachable;
+    }
+
+    fn manual(self: *Recorder) !Manual {
+        return try Manual.init(.{
+            .userdata = self,
+            .write = onWrite,
+            .resize = onResize,
+        });
+    }
+};
+
+test "Manual: writes pass through unchanged" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    m.write("hello\r\x1b[A", false);
+    m.write("", false);
+    try testing.expectEqual(@as(usize, 1), rec.writes.items.len);
+    try testing.expectEqualStrings("hello\r\x1b[A", rec.writes.items[0]);
+}
+
+test "Manual: linefeed mode turns CR into CRLF" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    m.write("a\rb\r\r", true);
+    const all = try rec.joined();
+    defer testing.allocator.free(all);
+    try testing.expectEqualStrings("a\r\nb\r\n\r\n", all);
+}
+
+test "Manual: linefeed translation splits large writes without losing bytes" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    // Every chunk boundary position relative to a CR is exercised by a
+    // CR every 7 bytes across several buffers' worth of data.
+    var input: [5000]u8 = undefined;
+    var expected: std.ArrayList(u8) = .empty;
+    defer expected.deinit(testing.allocator);
+    for (&input, 0..) |*ch, i| {
+        ch.* = if (i % 7 == 6) '\r' else @as(u8, 'a') + @as(u8, @intCast(i % 26));
+        try expected.append(testing.allocator, ch.*);
+        if (ch.* == '\r') try expected.append(testing.allocator, '\n');
+    }
+    m.write(&input, true);
+
+    try testing.expect(rec.writes.items.len > 1);
+    for (rec.writes.items) |w| {
+        try testing.expect(w.len <= 1024);
+        // A CR is never separated from its LF.
+        try testing.expect(w[w.len - 1] != '\r');
+    }
+    const all = try rec.joined();
+    defer testing.allocator.free(all);
+    try testing.expectEqualStrings(expected.items, all);
+}
+
+test "Manual: reports sizes once per change" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    try m.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
+    try m.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
+    try m.resize(.{ .columns = 100, .rows = 30 }, .{ .width = 1000, .height = 600 });
+    // A pixel-only change still matters for pixel-aware programs.
+    try m.resize(.{ .columns = 100, .rows = 30 }, .{ .width = 1001, .height = 600 });
+
+    try testing.expectEqualSlices(Size, &.{
+        .{ .columns = 80, .rows = 24, .width_px = 800, .height_px = 480 },
+        .{ .columns = 100, .rows = 30, .width_px = 1000, .height_px = 600 },
+        .{ .columns = 100, .rows = 30, .width_px = 1001, .height_px = 600 },
+    }, rec.sizes.items);
+}
+
+test "Manual: resize callback is optional" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try Manual.init(.{ .userdata = &rec, .write = Recorder.onWrite });
+    defer m.deinit();
+    try m.resize(.{ .columns = 80, .rows = 24 }, .{ .width = 800, .height = 480 });
+    try testing.expectEqual(@as(usize, 0), rec.sizes.items.len);
+}
+
+test "Manual: only the first exit request counts" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    try testing.expect(!m.exitRequested());
+    try testing.expect(m.requestExit(3));
+    try testing.expect(!m.requestExit(4));
+    try testing.expect(m.exitRequested());
+    try testing.expectEqual(exit_requested_bit | 3, m.exit_state.load(.acquire));
+}
+
+test "Manual: writes stop once an exit is requested" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    var td: termio.Termio.ThreadData = undefined;
+    td.backend = .{ .manual = .{ .manual = &m } };
+    try m.queueWrite(testing.allocator, &td, "before", false);
+    _ = m.requestExit(0);
+    try m.queueWrite(testing.allocator, &td, "after", false);
+    try testing.expectEqual(@as(usize, 1), rec.writes.items.len);
+    try testing.expectEqualStrings("before", rec.writes.items[0]);
+}
+
+test "Manual: exit requests race to a single winner" {
+    var rec: Recorder = .{};
+    defer rec.deinit();
+    var m = try rec.manual();
+    defer m.deinit();
+
+    var wins = std.atomic.Value(u32).init(0);
+    const Racer = struct {
+        fn run(manual: *Manual, code: u32, w: *std.atomic.Value(u32)) void {
+            if (manual.requestExit(code)) _ = w.fetchAdd(1, .monotonic);
+        }
+    };
+    var threads: [8]std.Thread = undefined;
+    for (&threads, 0..) |*t, i| t.* = try std.Thread.spawn(.{}, Racer.run, .{ &m, @as(u32, @intCast(i)), &wins });
+    for (threads) |t| t.join();
+    try testing.expectEqual(@as(u32, 1), wins.load(.acquire));
+}
