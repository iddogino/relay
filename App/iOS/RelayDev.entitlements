<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac app's (../Store/RelayDev.entitlements) without the
	     App Sandbox, which iOS apps are always in: the same Keychain group
	     (synced Relay keys and secrets reach every device) and iCloud
	     container. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>$(RELAY_CLOUDKIT_CONTAINER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Exporting for the App Store makes it production. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
